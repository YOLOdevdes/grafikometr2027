# Skopiuj do .env.local (lokalnie) albo ustaw w Vercel → Settings → Environment Variables.
ADMIN_PASSWORD=
# długi losowy ciąg, np. wynik: openssl rand -base64 48
SESSION_SECRET=
# losowy ciąg z liter/cyfr (min. 8 znaków) — link podglądu to /p/<PREVIEW_TOKEN>
PREVIEW_TOKEN=
# Upstash Redis — Vercel uzupełnia je sam po podpięciu bazy w zakładce Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=
